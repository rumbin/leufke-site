# --- Nikola / generated artefacts ---
output/
cache/
.doit.db*
__pycache__/
*.pyc
*.pyo

# --- OS / editor noise ---
.DS_Store
*.swp
*~

# --- Local config — never commit credentials! ---
# The FTP deploy target was removed from conf.py; a local, git-ignored file
# recreates it. Also ignore any stray credential/local-state files.
deploy_target.conf

# --- npm integration tests ---
# node_modules is reinstalled in CI from tests/package-lock.json.
tests/node_modules/

# Image pre-edit backups kept locally only (originals recoverable from git history).
*.backup

# --- Python packaging noise (kept minimal; source of truth is requirements) ---
.python-version
*.egg-info/
build/
dist/
.eggs/